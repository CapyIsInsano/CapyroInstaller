<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- CapyroInstaller.app (lo arma el CI: .github/workflows/build.yml). La versión
     la cambia el CI por la de Cargo.toml (VERSION). -->
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Capyro - Installer</string>
    <key>CFBundleDisplayName</key>
    <string>Capyro - Installer</string>
    <key>CFBundleExecutable</key>
    <string>CapyroInstaller</string>
    <key>CFBundleIdentifier</key>
    <string>io.github.capyisinsano.capyroinstaller</string>
    <key>CFBundleIconFile</key>
    <string>capyro.icns</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>VERSION</string>
    <key>CFBundleVersion</key>
    <string>VERSION</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleDevelopmentRegion</key>
    <string>es</string>
    <key>LSMinimumSystemVersion</key>
    <string>11.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
