// Recursos de CapyroInstaller.exe: ícono, versión y manifiesto.
#include <winver.h>

1 ICON "capyro.ico"
1 24 "installer.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     1,0,0,0
 PRODUCTVERSION  1,0,0,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "0c0a04b0"
        BEGIN
            VALUE "CompanyName",      "Capy y los Capibaras"
            VALUE "FileDescription",  "Capyro - Installer"
            VALUE "FileVersion",      "1.0.0"
            VALUE "InternalName",     "CapyroInstaller"
            VALUE "LegalCopyright",   "GPL-3.0-or-later"
            VALUE "OriginalFilename", "CapyroInstaller.exe"
            VALUE "ProductName",      "Capyro - Installer"
            VALUE "ProductVersion",   "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0c0a, 1200
    END
END
